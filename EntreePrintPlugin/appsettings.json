{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Plugin": {
    "BindAddress": "0.0.0.0",
    "HttpPort": 9779,
    "DiscoveryPort": 9778,
    "CorsAllowedOrigins": "*",
    "AccessToken": "",
    "RetryTimeoutMs": 60000,
    "RequestTimeoutMs": 3000,
    "BrowserExecutablePath": "",
    "PrinterStatusRefreshSeconds": 5,
    "PrintRetryMaxAttempts": 120,
    "PrintRetryDelayMs": 5000,
    "ReceiptRetentionDays": 7
  }
}
